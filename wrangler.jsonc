{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kobayashi-habitat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HABITAT",
        "class_name": "Habitat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Habitat"
      ]
    }
  ]
}
